#
# KDTree
#

# n > P * (log_2 P)^3
nPoint=1000
minCoord=-1000.0
maxCoord=1000.0

# P >= 2
nPim=64
# 1 <= D <= 15
dimensions=3
# 0 < a < 8
alpha=2.0
# a/2 < b < 2a
beta=2.0
# 1 <= 𝜙 <= 100
leafWrapThreshold=8
# log_2 n <= σ <= log_2^3 n
oversamplingRate=2
# 4 <= 𝜆 <= 10
sketchHeight=6
# 2^𝜆
chunkSize=64

#
# Logger
#

# Use stdout or set filename in log/
stream=run.log
# NONE / TEST / ERROR / DEBUG / INFO
severity=INFO
